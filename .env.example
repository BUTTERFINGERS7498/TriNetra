# Copy to .env and fill in. docker-compose reads this automatically.
# The orchestrator uses Azure when TARGET_URI and a key are both set.
TARGET_URI=https://your-resource.openai.azure.com/openai/v1
TARGET_KEY=
AZURE_OPENAI_API_KEY=

# Optional Anthropic fallback, used only when the Azure vars above are empty.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
