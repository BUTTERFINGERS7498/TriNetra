{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://trinetra-workspace.onrender.com/api/:path*"
    },
    { "source": "/workspace", "destination": "/workspace/index.html" },
    { "source": "/workspace/", "destination": "/workspace/index.html" }
  ]
}
