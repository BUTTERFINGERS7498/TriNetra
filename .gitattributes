# Normalise line endings. The CI runners, containers and the OpenResty gateway
# are all Linux, so anything executable or interpreted must be committed with
# LF — a CRLF shell script fails to run there.
* text=auto eol=lf

*.sh      text eol=lf
*.lua     text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.json    text eol=lf
Dockerfile text eol=lf

# PowerShell is Windows-side; keep CRLF.
*.ps1     text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
